// moonspace/cmd —— typed codegen 再生入口（A2 落形）
import {
  "moonbitlang/async",
  "moonbitlang/async/fs",
  "moonbitlang/core/encoding/utf8",
  "thy1016/moonspace/gen",
}

pkgtype(kind: "executable")

// native 本相:再生入口读 domain/*.toml(fs 面);可执行缺省 wasm
// 后端,跑法必带 --target native

supported_targets = "native"
